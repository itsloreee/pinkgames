<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>my cute games 💖</title>
  <style>
    body {
      background-color: #ffe6f0;
      font-family: 'comic sans ms', sans-serif;
      color: #ff3399;
      text-align: center;
      margin: 0;
      padding: 0;
    }
    header {
      background-color: #fff0f5;
      padding: 20px;
      font-size: 2em;
      font-weight: bold;
    }
    nav button {
      background-color: #ff99cc;
      border: none;
      padding: 10px 20px;
      margin: 5px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 1em;
      color: white;
    }
    section {
      display: none;
      padding: 20px;
    }
    section.active {
      display: block;
    }
    canvas {
      background-color: white;
      border: 3px solid #ff99cc;
      border-radius: 10px;
    }
    .clicker-btn {
      background-color: #ff66b2;
      border: none;
      padding: 20px 40px;
      border-radius: 20px;
      font-size: 1.5em;
      color: white;
      cursor: pointer;
    }
    .memory-card {
      width: 80px;
      height: 80px;
      background-color: #fff;
      border: 3px solid #ff99cc;
      display: inline-block;
      margin: 10px;
      font-size: 2em;
      line-height: 80px;
      cursor: pointer;
      border-radius: 15px;
    }
  </style>
</head>
<body>

<header>my cute games 💖</header>

<nav>
  <button onclick="showgame('snake')">snake</button>
  <button onclick="showgame('clicker')">clicker</button>
  <button onclick="showgame('memory')">memory</button>
</nav>

<section id="snake">
  <h2>snake game</h2>
  <canvas id="snakecanvas" width="300" height="300"></canvas>
  <p>use arrow keys to move the snake</p>
</section>

<section id="clicker">
  <h2>clicker game</h2>
  <p>score: <span id="clickscore">0</span></p>
  <button class="clicker-btn" onclick="clickscore()">click me 💖</button>
</section>

<section id="memory">
  <h2>memory game</h2>
  <div id="memoryboard"></div>
  <p>click 2 cards to match 💕</p>
</section>

<script>
  function showgame(id){
    document.querySelectorAll('section').forEach(s=>s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  // ===================== snake game =====================
  const canvas = document.getElementById('snakecanvas');
  const ctx = canvas.getContext('2d');
  const scale = 20;
  const rows = canvas.height / scale;
  const cols = canvas.width / scale;

  let snake = [{x: 60, y: 60}];
  let dx = scale;
  let dy = 0;
  let apple = {x: Math.floor(Math.random()*cols)*scale, y: Math.floor(Math.random()*rows)*scale};

  function draw(){
    ctx.fillStyle = '#ffe6f0';
    ctx.fillRect(0,0,canvas.width,canvas.height);

    ctx.fillStyle = '#ff3399';
    snake.forEach(part => ctx.fillRect(part.x, part.y, scale, scale));

    ctx.fillStyle = '#ff66b2';
    ctx.fillRect(apple.x, apple.y, scale, scale);
  }

  function update(){
    const head = {x: snake[0].x + dx, y: snake[0].y + dy};
    snake.unshift(head);

    if(head.x === apple.x && head.y === apple.y){
      apple = {x: Math.floor(Math.random()*cols)*scale, y: Math.floor(Math.random()*rows)*scale};
    } else {
      snake.pop();
    }

    // check collisions
    if(head.x < 0 || head.y < 0 || head.x >= canvas.width || head.y >= canvas.height || snake.slice(1).some(s=>s.x===head.x && s.y===head.y)){
      snake = [{x:60,y:60}]; dx=scale; dy=0;
    }
    draw();
  }

  document.addEventListener('keydown', e=>{
    if(e.key==='ArrowUp' && dy===0){dx=0;dy=-scale;}
    if(e.key==='ArrowDown' && dy===0){dx=0;dy=scale;}
    if(e.key==='ArrowLeft' && dx===0){dx=-scale;dy=0;}
    if(e.key==='ArrowRight' && dx===0){dx=scale;dy=0;}
  });

  setInterval(update, 200);

  // ===================== clicker game =====================
  let score = 0;
  function clickscore(){score++; document.getElementById('clickscore').textContent = score;}

  // ===================== memory game =====================
  const memoryboard = document.getElementById('memoryboard');
  const emojis = ['🍓','🍰','🎀','💖','🍩','🧸'];
  let cards = [...emojis,...emojis].sort(()=>Math.random()-0.5);
  let first = null, second = null;

  cards.forEach(e=>{
    const div = document.createElement('div');
    div.className = 'memory-card';
    div.textContent = '?';
    div.dataset.value = e;
    div.addEventListener('click', ()=>{
      if(div.textContent !== '?' || second) return;
      div.textContent = e;
      if(!first) first = div;
      else {
        second = div;
        if(first.dataset.value === second.dataset.value){
          first = null; second = null;
        } else {
          setTimeout(()=>{
            first.textContent = '?';
            second.textContent = '?';
            first = null; second = null;
          }, 800);
        }
      }
    });
    memoryboard.appendChild(div);
  });

</script>

</body>
</html>
